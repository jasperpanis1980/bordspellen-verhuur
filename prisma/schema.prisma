generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum RentalStatus {
  PENDING
  CONFIRMED
  REJECTED
  ACTIVE
  RETURNED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  rentals       Rental[]
  favorites     Favorite[]
  waitlistEntries Waitlist[]
}

model Game {
  id               String    @id @default(cuid())
  title            String
  shortDescription String    @default("")
  description      String
  category         String    @default("Familie")
  theme            String    @default("Overig")
  complexity       Float     @default(2)
  minAge           Int       @default(8)
  minPlayers       Int
  maxPlayers       Int
  playTime         Int
  imageUrl         String?
  productImageUrl  String?
  purchasePrice    Float     @default(0)
  totalCopies      Int       @default(1)
  rating           Float     @default(4.5)
  reviewCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  rentals          Rental[]
  images           GameImage[]
  variants         GameVariant[]
  reviews          Review[]
  favorites        Favorite[]
  waitlistEntries  Waitlist[]
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

model Waitlist {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    String
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
}

model Review {
  id         String   @id @default(cuid())
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId     String
  authorName String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}

model GameImage {
  id     String @id @default(cuid())
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String
  url    String
  order  Int    @default(0)
}

model GameVariant {
  id              String   @id @default(cuid())
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId          String
  name            String
  imageUrl        String?
  productImageUrl String?
  totalCopies     Int      @default(1)
  order           Int      @default(0)
  rentals         Rental[]
}

model Rental {
  id         String       @id @default(cuid())
  game       Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId     String
  variant    GameVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId  String?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  startDate  DateTime
  endDate    DateTime
  status     RentalStatus @default(PENDING)
  note       String?
  pickedUpAt    DateTime?
  returnedAt    DateTime?
  depositPaid   Boolean   @default(false)
  depositPaidAt DateTime?
  refundAmount  Float?
  refundPaid    Boolean   @default(false)
  refundPaidAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}
